TURSO_DATABASE_URL=file:./.data/passwd.db
TURSO_AUTH_TOKEN=
SESSION_SECRET=replace-with-long-random-secret-min-32
# In local Vite-proxy dev, point this at the frontend origin (cookie + CSRF).
BETTER_AUTH_URL=http://127.0.0.1:5173
FRONTEND_ORIGIN=http://127.0.0.1:5173
ENVIRONMENT=development
PORT=8787
# Set to chrome-extension://<id> to allow passwd-extension in local dev (see
# passwd-extension/wxt.config.ts WXT_EXTENSION_DEV_KEY for a stable dev id).
# Leave unset in production.
EXTENSION_ORIGIN=

# Production Turso credentials, used only by `npm run db:pull` / `db:push-data`
# (scripts/db-sync.ts) to sync data between this local DB and production.
# Never read by the dev server itself — TURSO_DATABASE_URL above still controls that.
# Get these from https://app.turso.tech after creating a database.
PROD_TURSO_DATABASE_URL=
PROD_TURSO_AUTH_TOKEN=
