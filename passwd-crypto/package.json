{
	"name": "passwd-crypto",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Client-side zero-knowledge crypto for Passwd (Argon2id + XChaCha20-Poly1305)",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"files": [
		"src",
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit --pretty",
		"test": "vitest",
		"test:ci": "vitest run --coverage --passWithNoTests",
		"lint": "eslint .",
		"format": "prettier --write .",
		"prepare": "husky || true"
	},
	"dependencies": {
		"@noble/ciphers": "^2.3.0",
		"@noble/curves": "^2.3.0",
		"@noble/hashes": "^2.3.0",
		"hash-wasm": "^4.12.0",
		"tweetnacl": "^1.0.3",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.8.0",
		"@commitlint/config-conventional": "^19.8.0",
		"@types/node": "^22.13.10",
		"@vitest/coverage-v8": "^3.0.8",
		"eslint": "^9.22.0",
		"husky": "^9.1.7",
		"lint-staged": "^15.4.3",
		"prettier": "^3.5.3",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.26.1",
		"vitest": "^3.0.8"
	},
	"lint-staged": {
		"src/**/*.{ts,js}": [
			"eslint --max-warnings=100 --fix"
		],
		"*.{json,md,yml,yaml}": [
			"prettier -w"
		]
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		],
		"rules": {
			"type-enum": [
				2,
				"always",
				[
					"feat",
					"fix",
					"docs",
					"style",
					"refactor",
					"perf",
					"test",
					"chore"
				]
			],
			"subject-case": [
				2,
				"always",
				"sentence-case"
			]
		}
	}
}
